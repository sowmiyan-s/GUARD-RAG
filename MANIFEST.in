include README.md
include LICENSE
include CHANGELOG.md
include requirements.txt
recursive-include docs *
recursive-include assets *
recursive-include .github *
include .env.example
recursive-include guardrag *.py *.typed
recursive-include guardrag/api/frontend *
include pyproject.toml
include MANIFEST.in
include Dockerfile
include docker-compose.yml

global-exclude *.py[cod] __pycache__ *.so *.dylib *.db .guardrag_storage*
prune .guardrag_storage
prune .pytest_cache
prune tests



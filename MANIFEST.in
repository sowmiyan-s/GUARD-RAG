include README.md
include LICENSE
include requirements.txt
include docs/INSTALL.md
include docs/QUICK_REFERENCE.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
recursive-include docs *
recursive-include assets *
include .env.example
recursive-include guardrag *.py *.typed
recursive-include guardrag/api/frontend *
include pyproject.toml
include MANIFEST.in
include Dockerfile
include docker-compose.yml

global-exclude *.py[cod] __pycache__ *.so *.dylib *.db .guardrag_storage*
prune .guardrag_storage
prune .pytest_cache
prune tests


